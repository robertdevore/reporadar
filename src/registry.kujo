// registry.kujo — RepoRadar Repo Registry CRUD Operations

from src.db import escape_sql
from src.metadata import redact_remote_url, normalize_commit_date
from src.scanner import validate_repo_path, validate_git_repo, get_canonical_path, scan_repo_with_options, collect_history_report

/// normalize_binary_flag converts dynamic API/import values to SQLite-safe 0/1.
export func normalize_binary_flag(value) {
	if value == true || value == 1 || to_string(value) == "true" || to_string(value) == "1" {
		return 1
	}
	return 0
}

/// add_repo validates and adds a repo to the registry.
export func add_repo(db, path, display_name, group_name, tags, notes, pinned) {
	if display_name == null { display_name = "" }
	if group_name == null { group_name = "" }
	if tags == null { tags = "" }
	if notes == null { notes = "" }
	pinned = normalize_binary_flag(pinned)

	// Validate path
	mut path_error = validate_repo_path(path)
	if path_error != null {
		return {"success": false, "error": path_error}
	}

	// Validate git repo
	if !validate_git_repo(path) {
		return {"success": false, "error": "Not a valid Git repository: " + path}
	}

	// Get canonical path
	mut canonical = get_canonical_path(path)

	// Check for duplicate path
	mut existing = db_query(db, "SELECT id FROM repos WHERE path = '" + escape_sql(canonical) + "'")
	if len(existing) > 0 {
		return {"success": false, "error": "Repository already tracked at: " + canonical}
	}

	// Derive name from path if not provided
	if display_name == "" {
		display_name = basename(canonical)
	}

	mut safe_name = escape_sql(display_name)
	mut safe_path = escape_sql(canonical)
	mut safe_group = escape_sql(group_name)
	mut safe_tags = escape_sql(tags)
	mut safe_notes = escape_sql(notes)

	db_execute(db, "INSERT INTO repos (name, display_name, path, group_name, tags, notes, pinned) VALUES ('" + safe_name + "', '" + safe_name + "', '" + safe_path + "', '" + safe_group + "', '" + safe_tags + "', '" + safe_notes + "', " + to_string(pinned) + ")")

	mut rows = db_query(db, "SELECT last_insert_rowid() as id")
	if len(rows) > 0 {
		mut repo_id = rows[0]["id"]
		return {"success": true, "id": to_int(repo_id), "path": canonical}
	}

	return {"success": false, "error": "Failed to retrieve new repo ID"}
}

/// remove_repo soft-deletes a repo from tracking (archives it).
export func remove_repo(db, repo_id) {
	mut rows = db_query(db, "SELECT id FROM repos WHERE id = " + to_string(repo_id))
	if len(rows) == 0 {
		return {"success": false, "error": "Repository not found with ID: " + to_string(repo_id)}
	}

	db_execute(db, "UPDATE repos SET archived = 1, updated_at = datetime('now') WHERE id = " + to_string(repo_id))
	return {"success": true}
}

/// update_repo updates repo metadata.
export func update_repo(db, repo_id, display_name, group_name, tags, notes, pinned, archived) {
	mut rows = db_query(db, "SELECT id FROM repos WHERE id = " + to_string(repo_id))
	if len(rows) == 0 {
		return {"success": false, "error": "Repository not found with ID: " + to_string(repo_id)}
	}

	mut updates = []
	if display_name != null {
		updates = push(updates, "display_name = '" + escape_sql(display_name) + "'")
	}
	if group_name != null {
		updates = push(updates, "group_name = '" + escape_sql(group_name) + "'")
	}
	if tags != null {
		updates = push(updates, "tags = '" + escape_sql(tags) + "'")
	}
	if notes != null {
		updates = push(updates, "notes = '" + escape_sql(notes) + "'")
	}
	if pinned != null {
		updates = push(updates, "pinned = " + to_string(normalize_binary_flag(pinned)))
	}
	if archived != null {
		updates = push(updates, "archived = " + to_string(normalize_binary_flag(archived)))
	}

	if len(updates) == 0 {
		return {"success": false, "error": "No fields to update"}
	}

	updates = push(updates, "updated_at = datetime('now')")

	mut set_clause = join(updates, ", ")
	db_execute(db, "UPDATE repos SET " + set_clause + " WHERE id = " + to_string(repo_id))
	return {"success": true}
}

/// get_all_repos returns all non-archived tracked repos with their latest status.
export func get_all_repos(db) {
	mut query = "SELECT r.*, s.branch, s.remote_url, s.upstream_branch, s.latest_commit_hash, s.latest_commit_short_hash, s.latest_commit_message, s.latest_commit_author, s.latest_commit_date, s.is_clean, s.staged_count, s.unstaged_count, s.untracked_count, s.changed_total, s.ahead_count, s.behind_count, s.is_diverged, s.is_detached, s.has_remote, s.dependabot_alert_count, s.dependabot_checked_at, s.scan_error, s.scanned_at FROM repos r LEFT JOIN repo_status_snapshots s ON s.id = (SELECT id FROM repo_status_snapshots WHERE repo_id = r.id ORDER BY scanned_at DESC, id DESC LIMIT 1) WHERE r.archived = 0 ORDER BY r.pinned DESC, r.name ASC"
	return db_query(db, query)
}

/// get_repo_stale_map returns latest-snapshot staleness keyed by repository ID.
export func get_repo_stale_map(db, stale_days) {
	mut days = stale_days
	if days <= 0 { days = 14 }
	mut rows = db_query(db, "SELECT r.id, CASE WHEN s.latest_commit_date IS NULL OR s.latest_commit_date = '' OR julianday('now') - julianday(CASE WHEN length(s.latest_commit_date) = 25 AND substr(s.latest_commit_date,20,1) = ' ' THEN substr(s.latest_commit_date,1,19) || substr(s.latest_commit_date,21,3) || ':' || substr(s.latest_commit_date,24,2) ELSE s.latest_commit_date END) > " + to_string(days) + " THEN 1 ELSE 0 END AS is_stale FROM repos r LEFT JOIN repo_status_snapshots s ON s.id = (SELECT id FROM repo_status_snapshots WHERE repo_id = r.id ORDER BY scanned_at DESC, id DESC LIMIT 1) WHERE r.archived = 0")
	mut stale_by_id = {}
	mut i = 0
	while i < len(rows) {
		stale_by_id[to_string(rows[i]["id"])] = rows[i]["is_stale"]
		i = i + 1
	}
	return stale_by_id
}

/// get_repo_by_id returns a single repo with its latest status.
export func get_repo_by_id(db, repo_id) {
	mut query = "SELECT r.*, s.id as snapshot_id, s.branch, s.remote_url, s.upstream_branch, s.latest_commit_hash, s.latest_commit_short_hash, s.latest_commit_message, s.latest_commit_author, s.latest_commit_date, s.is_clean, s.staged_count, s.unstaged_count, s.untracked_count, s.changed_total, s.ahead_count, s.behind_count, s.is_diverged, s.is_detached, s.has_remote, s.dependabot_alert_count, s.dependabot_checked_at, s.scan_error, s.scanned_at FROM repos r LEFT JOIN repo_status_snapshots s ON s.id = (SELECT id FROM repo_status_snapshots WHERE repo_id = r.id ORDER BY scanned_at DESC, id DESC LIMIT 1) WHERE r.id = " + to_string(repo_id)
	mut rows = db_query(db, query)
	if len(rows) > 0 {
		return rows[0]
	}
	return null
}

/// store_scan_result saves a scan result to the database.
export func store_scan_result(db, repo_id, scan_data) {
	db_begin_immediate(db)
	try {
		mut snapshot_id = write_scan_result(db, repo_id, scan_data)
		db_commit(db)
		return snapshot_id
	} except err {
		db_rollback(db)
		throw(err)
	}
}

// Caller owns the transaction; do not publish partially populated snapshots.
export func write_scan_result(db, repo_id, scan_data) {
	mut safe_branch = escape_sql(scan_data["branch"])
	mut safe_remote = escape_sql(redact_remote_url(scan_data["remote_url"]))
	mut safe_upstream = escape_sql(scan_data["upstream_branch"])
	mut safe_hash = escape_sql(scan_data["latest_commit_hash"])
	mut safe_short = escape_sql(scan_data["latest_commit_short_hash"])
	mut safe_msg = escape_sql(scan_data["latest_commit_message"])
	mut safe_author = escape_sql(scan_data["latest_commit_author"])
	mut safe_date = escape_sql(normalize_commit_date(db,scan_data["latest_commit_date"]))
	mut safe_error = escape_sql(scan_data["error"])
	mut dependabot_alert_count = -1
	if has_key(scan_data, "dependabot_alert_count") == 1 {
		dependabot_alert_count = to_int(scan_data["dependabot_alert_count"])
	}

	mut sql = "INSERT INTO repo_status_snapshots (repo_id, branch, remote_url, upstream_branch, latest_commit_hash, latest_commit_short_hash, latest_commit_message, latest_commit_author, latest_commit_date, is_clean, staged_count, unstaged_count, untracked_count, changed_total, ahead_count, behind_count, is_diverged, is_detached, has_remote, dependabot_alert_count, dependabot_checked_at, scan_error) VALUES (" + to_string(repo_id) + ", '" + safe_branch + "', '" + safe_remote + "', '" + safe_upstream + "', '" + safe_hash + "', '" + safe_short + "', '" + safe_msg + "', '" + safe_author + "', '" + safe_date + "', " + to_string(scan_data["is_clean"]) + ", " + to_string(scan_data["staged_count"]) + ", " + to_string(scan_data["unstaged_count"]) + ", " + to_string(scan_data["untracked_count"]) + ", " + to_string(scan_data["changed_total"]) + ", " + to_string(scan_data["ahead_count"]) + ", " + to_string(scan_data["behind_count"]) + ", " + to_string(scan_data["is_diverged"]) + ", " + to_string(scan_data["is_detached"]) + ", " + to_string(scan_data["has_remote"]) + ", " + to_string(dependabot_alert_count) + ", datetime('now'), '" + safe_error + "')"

	db_execute(db, sql)

	mut id_rows = db_query(db, "SELECT last_insert_rowid() as id")
	mut snapshot_id = 0
	if len(id_rows) > 0 {
		snapshot_id = to_int(id_rows[0]["id"])
	}

	// Store file changes
	if scan_data["success"] {
		mut file_changes = scan_data["file_changes"]
		mut fi = 0
		while fi < len(file_changes) {
			mut fc = file_changes[fi]
			fi = fi + 1
			mut safe_file = escape_sql(fc["file_path"])
			mut safe_code = escape_sql(fc["status_code"])
			mut safe_label = escape_sql(fc["status_label"])
			db_execute(db, "INSERT INTO repo_file_changes (repo_id, snapshot_id, file_path, status_code, status_label, staged, unstaged, untracked) VALUES (" + to_string(repo_id) + ", " + to_string(snapshot_id) + ", '" + safe_file + "', '" + safe_code + "', '" + safe_label + "', " + to_string(fc["staged"]) + ", " + to_string(fc["unstaged"]) + ", " + to_string(fc["untracked"]) + ")")
		}
	}

	// Update repo last_scan_at and last_error
	db_execute(db, "UPDATE repos SET last_scan_at = datetime('now'), last_error = '" + safe_error + "', updated_at = datetime('now') WHERE id = " + to_string(repo_id))
	trim_repo_history(db, repo_id, 250)

	return snapshot_id
}

/// trim_repo_history keeps recent scan snapshots bounded for long-lived registries.
export func trim_repo_history(db, repo_id, max_snapshots) {
	if max_snapshots <= 0 {
		return
	}
	mut repo_id_str = to_string(repo_id)
	mut max_str = to_string(max_snapshots)
	mut old_snapshot_query = "SELECT id FROM repo_status_snapshots WHERE repo_id = " + repo_id_str + " ORDER BY scanned_at DESC, id DESC LIMIT -1 OFFSET " + max_str
	db_execute(db, "DELETE FROM repo_file_changes WHERE snapshot_id IN (" + old_snapshot_query + ")")
	db_execute(db, "DELETE FROM repo_status_snapshots WHERE id IN (" + old_snapshot_query + ")")
}

/// get_repo_file_changes returns file changes for a repo's latest snapshot.
export func get_repo_file_changes(db, repo_id) {
	mut query = "SELECT fc.* FROM repo_file_changes fc WHERE fc.snapshot_id = (SELECT id FROM repo_status_snapshots WHERE repo_id = " + to_string(repo_id) + " ORDER BY scanned_at DESC, id DESC LIMIT 1) ORDER BY fc.file_path ASC"
	return db_query(db, query)
}

/// get_repo_scan_history returns recent scan snapshots for a repo.
export func get_repo_scan_history(db, repo_id, limit) {
	if limit == null { limit = 10 }
	return db_query(db, "SELECT * FROM repo_status_snapshots WHERE repo_id = " + to_string(repo_id) + " ORDER BY scanned_at DESC LIMIT " + to_string(limit))
}

/// store_repo_commits saves collected commits to the database.
export func store_repo_commits(db, repo_id, commits) {
	mut i = 0
	while i < len(commits) {
		mut c = commits[i]
		i = i + 1

		mut safe_hash = escape_sql(c["hash"])
		mut safe_short = escape_sql(c["short_hash"])
		mut safe_author = escape_sql(c["author"])
		mut safe_date = escape_sql(normalize_commit_date(db,c["date"]))
		mut safe_msg = escape_sql(c["message"])

		db_execute(db, "INSERT INTO repo_commits (repo_id, commit_hash, short_hash, author, date, message) VALUES (" + to_string(repo_id) + ", '" + safe_hash + "', '" + safe_short + "', '" + safe_author + "', '" + safe_date + "', '" + safe_msg + "') ON CONFLICT(repo_id, commit_hash) DO UPDATE SET short_hash=excluded.short_hash, author=excluded.author, date=excluded.date, message=excluded.message")
	}
}

/// get_repo_commits returns recent commits for a repo.
export func get_repo_commits(db, repo_id, limit) {
	if limit == null { limit = 20 }
	return db_query(db, "SELECT * FROM repo_commits WHERE repo_id = " + to_string(repo_id) + " ORDER BY date DESC LIMIT " + to_string(limit))
}

/// get_commits_in_window returns commits across all repos within a time window.
export func get_commits_in_window(db, days) {
	return db_query(db, "SELECT rc.*, r.name as repo_name, r.display_name as repo_display_name, r.path as repo_path FROM repo_commits rc INNER JOIN repos r ON rc.repo_id = r.id WHERE rc.date >= strftime('%Y-%m-%dT%H:%M:%SZ','now', '-" + to_string(days) + " days') AND r.archived = 0 ORDER BY rc.date DESC")
}

/// get_commits_by_day returns commit counts grouped by day for all repos.
export func get_commits_by_day(db, days) {
	return db_query(db, "SELECT date(rc.date) as day, COUNT(*) as count FROM repo_commits rc INNER JOIN repos r ON rc.repo_id = r.id WHERE rc.date >= strftime('%Y-%m-%dT%H:%M:%SZ','now', '-" + to_string(days) + " days') AND r.archived = 0 GROUP BY date(rc.date) ORDER BY day ASC")
}

/// get_commit_count_per_repo returns commit counts per repo for a time window.
export func get_commit_count_per_repo(db, days) {
	return db_query(db, "SELECT rc.repo_id, r.name as repo_name, r.display_name, r.path, COUNT(*) as commit_count FROM repo_commits rc INNER JOIN repos r ON rc.repo_id = r.id WHERE rc.date >= strftime('%Y-%m-%dT%H:%M:%SZ','now', '-" + to_string(days) + " days') AND r.archived = 0 GROUP BY rc.repo_id ORDER BY commit_count DESC")
}

/// Bounded activity feed and independent total; do not materialize the full history.
export func get_activity_feed(db, days) {
	return db_query(db, "SELECT rc.*, r.name as repo_name, r.display_name as repo_display_name, r.path as repo_path FROM repo_commits rc JOIN repos r ON rc.repo_id = r.id WHERE r.archived = 0 AND rc.date >= strftime('%Y-%m-%dT%H:%M:%SZ','now', '-" + to_string(days) + " days') ORDER BY rc.date DESC, rc.id DESC LIMIT 50")
}
export func get_activity_total(db, days) {
	return db_query(db, "SELECT COUNT(*) as total FROM repo_commits rc JOIN repos r ON rc.repo_id = r.id WHERE r.archived = 0 AND rc.date >= strftime('%Y-%m-%dT%H:%M:%SZ','now', '-" + to_string(days) + " days')")[0]["total"]
}

/// All production scan entrypoints share atomic snapshot/history publication.
/// Git commands run before the write transaction. HEAD history replaces the cache,
/// so force-pushes, branch switches and repaired metadata cannot leave ghost commits.
export func scan_and_store(db, repo_id, path, enable_alerts) {
	mut scan = scan_repo_with_options(path, enable_alerts)
	mut history = {"commits":[],"complete":false,"limit":10000}
	if scan["success"] {
		try {
			history = collect_history_report(path,10000)
			if len(history["commits"]) > 0 && history["commits"][0]["hash"] != scan["latest_commit_hash"] { throw("HEAD changed during scan") }
		} except err {
			scan["success"] = false
			scan["error"] = "History collection failed: " + to_string(err) + "; retry the scan"
		}
	}
	db_begin_immediate(db)
	try {
		mut snapshot_id = write_scan_result(db,repo_id,scan)
		mut complete = 0
		mut error = scan["error"]
		if scan["success"] {
			db_execute(db,"DELETE FROM repo_commits WHERE repo_id=" + to_string(repo_id))
			store_repo_commits(db,repo_id,history["commits"])
			if history["complete"] { complete = 1; error = "" }
			else { error = history["error"] }
		}
		db_execute(db,"UPDATE repos SET history_complete=" + to_string(complete) + ", history_error='" + escape_sql(error) + "', history_scanned_at=datetime('now') WHERE id=" + to_string(repo_id))
		db_commit(db)
		scan["snapshot_id"] = snapshot_id
		scan["history_complete"] = complete
		scan["history_error"] = error
		return scan
	} except err { db_rollback(db); throw(err) }
}
