// main.kujo — RepoRadar CLI Entry Point
// Usage: kujo run src/main.kujo [command] [options]

from src.server import start_server, discover_report
from src.scanner import scan_repo_with_options, collect_recent_commits
from src.registry import add_repo, remove_repo, get_all_repos, get_repo_by_id, get_repo_stale_map, store_scan_result, store_repo_commits
from src.db import init_db, init_db_with_options, get_setting, get_db_path
from src.health_report import build_review_report, report_exit_code
from src.version import app_version

/// print_usage displays the CLI contract for humans and automation.
export func print_usage() {
	print("RepoRadar v" + app_version() + " — Local Git Repository Dashboard")
	print("")
	print("Usage: kujo run src/main.kujo <command> [options]")
	print("")
	print("Health commands:")
	print("  list [filters]                  Show detailed latest repository health")
	print("  scan <repo-id> [options]        Scan one tracked repository")
	print("  scan-all [options]              Scan every repository and report results")
	print("  review [options]                Report actionable repositories for agents")
	print("")
	print("Registry commands:")
	print("  add <path>                      Add a repository")
	print("  remove <repo-id>                Remove a repository from tracking")
	print("  discover <path>                 Discover repositories under a directory")
	print("  export                          Export the registry to JSON")
	print("  doctor [--json]                Verify runtime, database, and registry health")
	print("  version [--json]               Print the RepoRadar version")
	print("  serve [port]                    Start the dashboard server (default: 8080)")
	print("  help                            Show this help")
	print("")
	print("Health options:")
	print("  --json                          Emit JSON only (schema_version: 1)")
	print("  --summary                       JSON summary with an empty repos array")
	print("  --output=<path>                 Save health JSON and emit a concise receipt")
	print("  --dirty-only                    Include only dirty working trees")
	print("  --attention-only                Include only repositories needing attention")
	print("  --fail-on-attention             Exit 3 when attention items exist")
	print("  --scan                          Refresh all repositories before review")
	print("  --all                           Include all repositories in review output")
	print("  --no-fail-on-attention          Keep review exit 0 when only attention exists")
	print("")
	print("Exit codes:")
	print("  0  Command completed successfully")
	print("  1  Scan or operational error")
	print("  2  Invalid command or arguments")
	print("  3  Attention items found when attention failure is enabled")
	print("")
	print("Examples:")
	print("  kujo run src/main.kujo scan-all --json")
	print("  kujo run src/main.kujo list --dirty-only")
	print("  kujo run src/main.kujo review --scan --json")
	print("  kujo run src/main.kujo review --all --no-fail-on-attention")
}

/// has_flag checks whether an exact CLI flag is present.
export func has_flag(argv, wanted) {
	mut i = 0
	while i < len(argv) {
		if argv[i] == wanted { return true }
		i = i + 1
	}
	return false
}

/// positional_arg returns the first non-flag argument from a position onward.
export func positional_arg(argv, start_index, default_value) {
	mut i = start_index
	while i < len(argv) {
		if starts_with(argv[i], "--") == false { return argv[i] }
		i = i + 1
	}
	return default_value
}

/// unknown_flag returns the first unsupported option or an empty string.
export func unknown_flag(argv, allowed) {
	mut i = 1
	while i < len(argv) {
		mut token = argv[i]
		if starts_with(token, "--") {
			mut known = false
			mut j = 0
			while j < len(allowed) {
				if token == allowed[j] { known = true }
				if allowed[j] == "--output=" && starts_with(token, "--output=") { known = true }
				j = j + 1
			}
			if token == "--output=" { return "--output= requires a file path" }
			if known == false { return token }
		}
		i = i + 1
	}
	return ""
}

/// Optional machine-output modes keep default schema/output unchanged.
export func output_path(argv) {
	mut i = 0
	while i < len(argv) {
		if starts_with(argv[i], "--output=") { return substring(argv[i], 9, len(argv[i])) }
		i = i + 1
	}
	return ""
}
export func emit_health_report(report, argv, title) {
	mut path = output_path(argv)
	if has_flag(argv, "--summary") {
		report["repos"] = []
		report["summary_only"] = true
	}
	if path != "" {
		try { write_file(path, to_json_pretty(report)) } except err {
			emit_cli_error(true, "Could not write report: " + to_string(err), 1)
			return false
		}
		print(to_json({"success":report["success"],"output":path,"exit_code":report["exit_code"]}))
	} else if has_flag(argv, "--json") || has_flag(argv, "--summary") {
		print(to_json_pretty(report))
	} else { print_human_report(report, title) }
	return true
}

/// emit_cli_error keeps JSON command failures machine-parseable.
export func emit_cli_error(json_mode, message, code) {
	if json_mode {
		print(to_json_pretty({"success": false, "error": message, "exit_code": code}))
	} else {
		print("Error: " + message)
	}
}

/// current_timestamp returns a database-generated timestamp.
export func current_timestamp(db) {
	mut rows = db_query(db, "SELECT datetime('now') as generated_at")
	if len(rows) > 0 && rows[0]["generated_at"] != null {
		return rows[0]["generated_at"]
	}
	return ""
}

/// load_health_report reads latest snapshots and creates normalized output.
export func load_health_report(db, include_mode) {
	mut repos = get_all_repos(db)
	mut stale_days = parse_int(get_setting(db, "stale_threshold_days", "14"))
	mut stale_by_id = get_repo_stale_map(db, stale_days)
	return build_review_report(repos, stale_by_id, include_mode, current_timestamp(db))
}

/// print_human_report renders a compact but actionable terminal view.
export func print_human_report(report, title) {
	mut summary = report["summary"]
	print("")
	print("=== " + title + " ===")
	print("Total " + to_string(summary["total"]) + " | Clean " + to_string(summary["clean"]) + " | Dirty " + to_string(summary["dirty"]) + " | Errors " + to_string(summary["errors"]) + " | Unscanned " + to_string(summary["unscanned"]) + " | Attention " + to_string(summary["attention"]))
	print("Changed files " + to_string(summary["changed_files"]) + " | Ahead " + to_string(summary["ahead"]) + " | Behind " + to_string(summary["behind"]) + " | Diverged " + to_string(summary["diverged"]) + " | Stale " + to_string(summary["stale"]) + " | Alerts " + to_string(summary["security_alerts"]))
	print("")
	mut repos = report["repos"]
	if len(repos) == 0 {
		print("No repositories matched this view.")
		print("")
		return
	}
	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		i = i + 1
		mut branch = repo["branch"]
		if branch == "" { branch = "no branch" }
		print("  [" + repo["status"] + "/" + repo["priority"] + "] " + repo["name"] + " — " + branch)
		print("      " + repo["path"])
		print("      Changes: " + to_string(repo["changed_total"]) + " (" + to_string(repo["staged"]) + " staged, " + to_string(repo["unstaged"]) + " unstaged, " + to_string(repo["untracked"]) + " untracked) | Sync: +" + to_string(repo["ahead"]) + "/-" + to_string(repo["behind"]))
		if len(repo["attention_reasons"]) > 0 {
			print("      Attention: " + join(repo["attention_reasons"], ", "))
		}
		if repo["scan_error"] != "" {
			print("      Scan error: " + repo["scan_error"])
		}
		if repo["scanned_at"] != "" {
			print("      Last scan: " + repo["scanned_at"])
		}
	}
	print("")
}

/// run_bulk_scan performs and records one complete CLI scan run.
export func run_bulk_scan(db, quiet) {
	mut repos = get_all_repos(db)
	db_execute(db, "INSERT INTO scan_runs (repo_count) VALUES (" + to_string(len(repos)) + ")")
	mut run_rows = db_query(db, "SELECT last_insert_rowid() as id")
	mut run_id = to_int(run_rows[0]["id"])
	mut result = {"performed": true, "run_id": run_id, "total": len(repos), "succeeded": 0, "errors": 0, "clean": 0, "dirty": 0, "repo_results": []}
	if quiet == false { print("Scanning " + to_string(len(repos)) + " repos...") }
	mut enable_dependabot_alerts = get_setting(db, "enable_dependabot_alerts", "false") == "true"
	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		i = i + 1
		mut name = get_default(repo, "display_name", get_default(repo, "name", "?"))
		if quiet == false { print("  [" + to_string(i) + "/" + to_string(len(repos)) + "] " + name + " ...") }
		mut scan_result = scan_repo_with_options(repo["path"], enable_dependabot_alerts)
		store_scan_result(db, repo["id"], scan_result)
		if scan_result["success"] {
			result["succeeded"] = result["succeeded"] + 1
			if scan_result["is_clean"] == 1 { result["clean"] = result["clean"] + 1 } else { result["dirty"] = result["dirty"] + 1 }
			mut commits = collect_recent_commits(repo["path"], 0)
			store_repo_commits(db, repo["id"], commits)
		} else {
			result["errors"] = result["errors"] + 1
			if quiet == false { print("    Error: " + scan_result["error"]) }
		}
		result["repo_results"] = push(result["repo_results"], {"repo_id": repo["id"], "name": name, "success": scan_result["success"], "error": scan_result["error"]})
	}
	db_execute(db, "UPDATE scan_runs SET completed_at = datetime('now'), success_count = " + to_string(result["succeeded"]) + ", error_count = " + to_string(result["errors"]) + ", clean_count = " + to_string(result["clean"]) + ", dirty_count = " + to_string(result["dirty"]) + " WHERE id = " + to_string(run_id))
	return result
}

/// cmd_list reports the latest stored repository state.
export func cmd_list(argv) {
	mut invalid = unknown_flag(argv, ["--json", "--summary", "--output=", "--dirty-only", "--attention-only"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }
	mut include_mode = "all"
	if has_flag(argv, "--attention-only") { include_mode = "attention" }
	if has_flag(argv, "--dirty-only") { include_mode = "dirty" }
	mut db = init_db_with_options(json_mode == false)
	mut report = load_health_report(db, include_mode)
	report["command"] = "list"
	report["success"] = true
	report["exit_code"] = 0
	if !emit_health_report(report, argv, "Repository Health") { return 1 }
	return 0
}

/// cmd_scan scans a single repository and returns its normalized status.
export func cmd_scan(repo_id_str, argv) {
	mut invalid = unknown_flag(argv, ["--json", "--summary", "--output=", "--fail-on-attention"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }
	mut repo_id = parse_int(repo_id_str)
	if repo_id <= 0 { emit_cli_error(json_mode, "repo ID must be a positive number", 2); return 2 }
	mut db = init_db_with_options(json_mode == false)
	mut repo = get_repo_by_id(db, repo_id)
	if repo == null { emit_cli_error(json_mode, "repo not found", 1); return 1 }
	if json_mode == false { print("Scanning: " + repo["path"] + " ...") }
	mut enable_dependabot_alerts = get_setting(db, "enable_dependabot_alerts", "false") == "true"
	mut scan_result = scan_repo_with_options(repo["path"], enable_dependabot_alerts)
	store_scan_result(db, repo_id, scan_result)
	if scan_result["success"] {
		mut commits = collect_recent_commits(repo["path"], 0)
		store_repo_commits(db, repo_id, commits)
	}
	mut fresh_repo = get_repo_by_id(db, repo_id)
	mut stale_map = get_repo_stale_map(db, parse_int(get_setting(db, "stale_threshold_days", "14")))
	mut report = build_review_report([fresh_repo], stale_map, "all", current_timestamp(db))
	report["command"] = "scan"
	report["scan"] = {"performed": true, "repo_id": repo_id, "success": scan_result["success"], "error": scan_result["error"]}
	mut exit_code = 0
	if scan_result["success"] == false {
		exit_code = 1
	} else {
		mut fail_on_attention = 0
		if has_flag(argv, "--fail-on-attention") { fail_on_attention = 1 }
		exit_code = report_exit_code(report, fail_on_attention)
	}
	report["success"] = scan_result["success"]
	report["exit_code"] = exit_code
	if !emit_health_report(report, argv, "Repository Scan") { return 1 }
	return exit_code
}

/// cmd_scan_all scans all repositories and emits a complete health report.
export func cmd_scan_all(argv) {
	mut invalid = unknown_flag(argv, ["--json", "--summary", "--output=", "--dirty-only", "--attention-only", "--fail-on-attention"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }
	mut include_mode = "all"
	if has_flag(argv, "--attention-only") { include_mode = "attention" }
	if has_flag(argv, "--dirty-only") { include_mode = "dirty" }
	mut db = init_db_with_options(json_mode == false)
	mut scan_info = run_bulk_scan(db, json_mode)
	mut report = load_health_report(db, include_mode)
	report["command"] = "scan-all"
	report["scan"] = scan_info
	mut fail_on_attention = 0
	if has_flag(argv, "--fail-on-attention") { fail_on_attention = 1 }
	mut exit_code = report_exit_code(report, fail_on_attention)
	if scan_info["errors"] > 0 { exit_code = 1 }
	report["success"] = scan_info["errors"] == 0
	report["exit_code"] = exit_code
	if !emit_health_report(report, argv, "Bulk Scan Results") { return 1 }
	return exit_code
}

/// cmd_review provides the opinionated agent review surface.
export func cmd_review(argv) {
	mut invalid = unknown_flag(argv, ["--json", "--summary", "--output=", "--dirty-only", "--attention-only", "--scan", "--all", "--fail-on-attention", "--no-fail-on-attention"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }
	mut include_mode = "attention"
	if has_flag(argv, "--all") { include_mode = "all" }
	if has_flag(argv, "--dirty-only") { include_mode = "dirty" }
	mut db = init_db_with_options(json_mode == false)
	mut scan_info = {"performed": false, "run_id": 0, "total": 0, "succeeded": 0, "errors": 0, "clean": 0, "dirty": 0, "repo_results": []}
	if has_flag(argv, "--scan") { scan_info = run_bulk_scan(db, json_mode) }
	mut report = load_health_report(db, include_mode)
	report["command"] = "review"
	report["scan"] = scan_info
	mut fail_on_attention = 1
	if has_flag(argv, "--no-fail-on-attention") { fail_on_attention = 0 }
	mut exit_code = report_exit_code(report, fail_on_attention)
	if scan_info["errors"] > 0 { exit_code = 1 }
	report["success"] = scan_info["errors"] == 0 && report["summary"]["errors"] == 0
	report["exit_code"] = exit_code
	if !emit_health_report(report, argv, "Ecosystem Review") { return 1 }
	return exit_code
}

/// cmd_add adds a repository by path.
export func cmd_add(path) {
	mut db = init_db()
	mut result = add_repo(db, path, "", "", "", "", 0)
	if result["success"] { print("Added repo: " + result["path"] + " (ID: " + to_string(result["id"]) + ")"); return 0 }
	print("Error: " + result["error"])
	return 1
}

/// cmd_remove removes a repository from tracking.
export func cmd_remove(repo_id_str) {
	mut db = init_db()
	mut result = remove_repo(db, parse_int(repo_id_str))
	if result["success"] { print("Repo " + repo_id_str + " removed from tracking."); return 0 }
	print("Error: " + result["error"])
	return 1
}

/// cmd_discover finds Git repositories under a parent directory.
export func cmd_discover(parent_path) {
	mut db = init_db()
	mut ignored_str = get_setting(db, "ignored_folders", "node_modules,vendor,.cache,dist,build,.git")
	mut discovery = discover_report(parent_path, 3, 0, split(ignored_str, ","), {"entries_remaining":25000,"results_remaining":1000})
	mut discovered = discovery["repos"]
	if discovery["truncated"] { print("WARNING: discovery limits reached; results are incomplete. Search a narrower directory.") }
	print("")
	print("=== Discovered " + to_string(len(discovered)) + " Git repos under " + parent_path + " ===")
	print("")
	mut i = 0
	while i < len(discovered) { print("  " + discovered[i]["name"] + " — " + discovered[i]["path"]); i = i + 1 }
	print("")
	return 0
}

/// cmd_export exports the registry to JSON.
export func cmd_export() {
	mut db = init_db()
	mut repos = get_all_repos(db)
	mut settings_rows = db_query(db, "SELECT key, value FROM settings")
	mut settings = {}
	mut i = 0
	while i < len(settings_rows) { settings[settings_rows[i]["key"]] = settings_rows[i]["value"]; i = i + 1 }
	mut export_data = {"app": "reporadar", "version": app_version(), "exported_at": current_timestamp(db), "settings": settings, "repos": repos}
	write_file("reporadar-export.json", to_json_pretty(export_data), {"overwrite": true})
	print("Exported " + to_string(len(repos)) + " repos to reporadar-export.json")
	return 0
}

/// cmd_version emits a stable human or machine-readable version result.
export func cmd_version(argv) {
	mut invalid = unknown_flag(argv, ["--json"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }
	if json_mode {
		print(to_json_pretty({"success": true, "app": "reporadar", "version": app_version(), "exit_code": 0}))
	} else {
		print("RepoRadar v" + app_version())
	}
	return 0
}

/// cmd_doctor verifies the dependencies and state agents need before automation.
export func cmd_doctor(argv) {
	mut invalid = unknown_flag(argv, ["--json"])
	mut json_mode = has_flag(argv, "--json") || has_flag(argv, "--summary") || output_path(argv) != ""
	if invalid != "" { emit_cli_error(json_mode, "unknown option: " + invalid, 2); return 2 }

	mut git_result = execute_status("git --version")
	mut git_ok = git_result.success && git_result.exitcode == 0
	mut kujo_result = execute_status("kujo --version")
	mut kujo_ok = kujo_result.success && kujo_result.exitcode == 0
	mut report = {
		"success": false,
		"app": "reporadar",
		"version": app_version(),
		"database_path": get_db_path(),
		"schema_version": 0,
		"tracked_repositories": 0,
		"kujo": {"ok": kujo_ok, "version": trim(kujo_result.stdout)},
		"git": {"ok": git_ok, "version": trim(git_result.stdout)},
		"database": {"ok": false},
		"exit_code": 1
	}

	try {
		mut db = init_db_with_options(json_mode == false)
		mut version_rows = db_query(db, "SELECT MAX(version) as version FROM schema_version")
		if len(version_rows) > 0 && version_rows[0]["version"] != null {
			report["schema_version"] = to_int(version_rows[0]["version"])
		}
		mut repo_rows = db_query(db, "SELECT COUNT(*) as count FROM repos WHERE archived = 0")
		if len(repo_rows) > 0 {
			report["tracked_repositories"] = to_int(repo_rows[0]["count"])
		}
		report["database"] = {"ok": true}
	} except err {
		report["database"] = {"ok": false, "error": "Database initialization or query failed"}
	}

	report["success"] = kujo_ok && git_ok && report["database"]["ok"]
	if report["success"] { report["exit_code"] = 0 }
	if json_mode {
		print(to_json_pretty(report))
	} else {
		mut kujo_status = "missing or unavailable"
		if kujo_ok { kujo_status = "ok — " + report["kujo"]["version"] }
		mut git_status = "missing or unavailable"
		if git_ok { git_status = "ok — " + report["git"]["version"] }
		mut database_status = "unavailable"
		if report["database"]["ok"] { database_status = "ok — schema " + to_string(report["schema_version"]) }
		print("")
		print("=== RepoRadar Doctor ===")
		print("Kujo: " + kujo_status)
		print("Git: " + git_status)
		print("Database: " + database_status)
		print("Tracked repositories: " + to_string(report["tracked_repositories"]))
		print("")
	}
	return report["exit_code"]
}

/// main routes commands and terminates with documented exit codes.
export func main() {
	mut argv = args()
	mut cmd = "serve"
	if len(argv) > 0 { cmd = argv[0] }
	if cmd == "help" || cmd == "--help" || cmd == "-h" { print_usage(); return 0 }
	if cmd == "serve" {
		mut port = parse_int(positional_arg(argv, 1, "8080"))
		if port <= 0 || port > 65535 { print("Error: port must be between 1 and 65535"); return 2 }
		start_server(port)
		return 0
	}
	if cmd == "list" { return cmd_list(argv) }
	if cmd == "scan" { return cmd_scan(positional_arg(argv, 1, ""), argv) }
	if cmd == "scan-all" { return cmd_scan_all(argv) }
	if cmd == "review" { return cmd_review(argv) }
	if cmd == "doctor" { return cmd_doctor(argv) }
	if cmd == "version" || cmd == "--version" { return cmd_version(argv) }
	if cmd == "add" {
		mut path = positional_arg(argv, 1, "")
		if path == "" { print("Error: path is required"); return 2 }
		return cmd_add(path)
	}
	if cmd == "remove" {
		mut repo_id = positional_arg(argv, 1, "")
		if parse_int(repo_id) <= 0 { print("Error: repo ID must be a positive number"); return 2 }
		return cmd_remove(repo_id)
	}
	if cmd == "discover" {
		mut path = positional_arg(argv, 1, "")
		if path == "" { print("Error: parent path is required"); return 2 }
		return cmd_discover(path)
	}
	if cmd == "export" { return cmd_export() }
	print("Error: unknown command: " + cmd)
	print_usage()
	return 2
}

exit(main())
