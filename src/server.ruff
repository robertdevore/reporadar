// server.ruff — RepoRadar HTTP Server + API Routes
// Serves the dashboard UI and provides JSON API endpoints.

from src.db import init_db, get_db_path, get_setting, set_setting
from src.scanner import validate_git_repo, validate_repo_path, get_canonical_path, scan_repo, collect_recent_commits
from src.registry import add_repo, remove_repo, update_repo, get_all_repos, get_repo_by_id, store_scan_result, store_repo_commits, get_repo_file_changes, get_repo_scan_history, get_repo_commits, get_commits_in_window, get_commits_by_day, get_commit_count_per_repo

/// cors_headers returns common CORS headers for local development.
export func cors_headers() {
	return {
		"Access-Control-Allow-Origin": "*",
		"Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
		"Access-Control-Allow-Headers": "Content-Type",
		"Content-Type": "application/json"
	}
}

/// handle_options handles CORS preflight requests.
export func handle_options(req) {
	mut resp = http_response(204, "")
	mut headers = cors_headers()
	mut hkeys = keys(headers)
	mut i = 0
	while i < len(hkeys) {
		mut k = hkeys[i]
		resp = set_header(resp, k, headers[k])
		i = i + 1
	}
	return resp
}

/// add_cors adds CORS headers to a response.
export func add_cors(resp) {
	mut headers = cors_headers()
	mut hkeys = keys(headers)
	mut i = 0
	while i < len(hkeys) {
		mut k = hkeys[i]
		resp = set_header(resp, k, headers[k])
		i = i + 1
	}
	return resp
}

/// api_list_repos returns all tracked repos with latest status.
export func api_list_repos(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)

	mut result = {
		"success": true,
		"repos": repos,
		"total": len(repos)
	}

	return add_cors(json_response(200, result))
}

/// api_add_repo handles POST to add a new repo.
export func api_add_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut body = req["body"]
	mut data = parse_json(body)

	mut path = get(data, "path")
	if path == null || path == "" {
		return add_cors(json_response(400, {"success": false, "error": "Path is required"}))
	}

	mut display_name = get_default(data, "display_name", "")
	mut group_name = get_default(data, "group_name", "")
	mut tags = get_default(data, "tags", "")
	mut notes = get_default(data, "notes", "")
	mut pinned = get_default(data, "pinned", 0)

	mut db = init_db()
	mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)

	return add_cors(json_response(200, result))
}

/// api_remove_repo handles DELETE to remove a repo.
export func api_remove_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "DELETE" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}))
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()
	mut result = remove_repo(db, repo_id)

	return add_cors(json_response(200, result))
}

/// api_update_repo handles PUT to update repo metadata.
export func api_update_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "PUT" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}))
	}

	mut repo_id = parse_int(repo_id_str)
	mut body = req["body"]
	mut data = parse_json(body)

	mut display_name = get(data, "display_name")
	mut group_name = get(data, "group_name")
	mut tags = get(data, "tags")
	mut notes = get(data, "notes")
	mut pinned = get(data, "pinned")
	mut archived = get(data, "archived")

	mut db = init_db()
	mut result = update_repo(db, repo_id, display_name, group_name, tags, notes, pinned, archived)

	return add_cors(json_response(200, result))
}

/// api_scan_repo handles POST to scan a single repo.
export func api_scan_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}))
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()

	// Get the repo path
	mut repo = get_repo_by_id(db, repo_id)
	if repo == null {
		return add_cors(json_response(404, {"success": false, "error": "Repo not found"}))
	}

	mut repo_path = repo["path"]

	// Run the scan
	mut scan_result = scan_repo(repo_path)

	// Store the result
	mut snapshot_id = 0
	if scan_result["success"] {
		snapshot_id = store_scan_result(db, repo_id, scan_result)

		// Collect recent commits
		mut commits = collect_recent_commits(repo_path, 0)
		store_repo_commits(db, repo_id, commits)
	} else {
		// Store error result
		store_scan_result(db, repo_id, scan_result)
	}

	// Return updated repo data
	mut updated_repo = get_repo_by_id(db, repo_id)
	mut file_changes = get_repo_file_changes(db, repo_id)

	return add_cors(json_response(200, {
		"success": scan_result["success"],
		"repo": updated_repo,
		"scan_result": scan_result,
		"file_changes": file_changes,
		"snapshot_id": snapshot_id
	}))
}

/// api_repo_detail returns detailed info for a single repo.
export func api_repo_detail(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}))
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()

	mut repo = get_repo_by_id(db, repo_id)
	if repo == null {
		return add_cors(json_response(404, {"success": false, "error": "Repo not found"}))
	}

	mut file_changes = get_repo_file_changes(db, repo_id)
	mut recent_commits = get_repo_commits(db, repo_id, 20)
	mut scan_history = get_repo_scan_history(db, repo_id, 10)

	return add_cors(json_response(200, {
		"success": true,
		"repo": repo,
		"file_changes": file_changes,
		"recent_commits": recent_commits,
		"scan_history": scan_history
	}))
}

/// api_dashboard_summary returns summary counts for the dashboard header.
export func api_dashboard_summary(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)

	mut summary = {
		"total": len(repos),
		"clean": 0,
		"dirty": 0,
		"ahead": 0,
		"behind": 0,
		"diverged": 0,
		"no_remote": 0,
		"errors": 0,
		"stale": 0,
		"most_recently_active": "",
		"last_full_scan": ""
	}

	mut stale_days_str = get_setting(db, "stale_threshold_days", "14")
	mut stale_days = parse_int(stale_days_str)
	mut most_recent_date = ""

	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		i = i + 1

		if has_key(repo, "is_clean") == 1 {
			if repo["is_clean"] == 1 {
				summary["clean"] = summary["clean"] + 1
			} else {
				summary["dirty"] = summary["dirty"] + 1
			}
		}

		if has_key(repo, "ahead_count") == 1 {
			if to_int(repo["ahead_count"]) > 0 && to_int(repo["behind_count"]) > 0 {
				summary["diverged"] = summary["diverged"] + 1
			} else if to_int(repo["ahead_count"]) > 0 {
				summary["ahead"] = summary["ahead"] + 1
			} else if to_int(repo["behind_count"]) > 0 {
				summary["behind"] = summary["behind"] + 1
			}
		}

		if has_key(repo, "has_remote") == 1 {
			if repo["has_remote"] == 0 || repo["has_remote"] == null {
				summary["no_remote"] = summary["no_remote"] + 1
			}
		}

		if has_key(repo, "scan_error") == 1 {
			if repo["scan_error"] != null && repo["scan_error"] != "" {
				summary["errors"] = summary["errors"] + 1
			}
		}

		// Most recently active
		if has_key(repo, "latest_commit_date") == 1 {
			if repo["latest_commit_date"] != null && repo["latest_commit_date"] > most_recent_date {
				most_recent_date = repo["latest_commit_date"]
				summary["most_recently_active"] = get_default(repo, "display_name", get_default(repo, "name", ""))
			}
		}

		// Stale detection relies on the frontend to compute staleness
	}

	// Get last full scan time
	mut scan_rows = db_query(db, "SELECT MAX(completed_at) as last_scan FROM scan_runs")
	if len(scan_rows) > 0 && scan_rows[0]["last_scan"] != null {
		summary["last_full_scan"] = scan_rows[0]["last_scan"]
	}

	return add_cors(json_response(200, {"success": true, "summary": summary}))
}

/// api_activity returns commit activity data.
export func api_activity(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut query_params = req["query"]
	mut days_str = get_default(query_params, "days", "7")
	mut days = parse_int(days_str)

	mut db = init_db()
	mut commits = get_commits_in_window(db, days)
	mut commits_by_day = get_commits_by_day(db, days)
	mut commits_per_repo = get_commit_count_per_repo(db, days)

	// Determine most active and least active repos
	mut most_active = []
	mut least_active = []
	mut stale_repos = []

	if len(commits_per_repo) > 0 {
		// Most active: top 5
		mut ma_count = len(commits_per_repo)
		if ma_count > 5 { ma_count = 5 }
		mut idx = 0
		while idx < ma_count {
			most_active = push(most_active, commits_per_repo[idx])
			idx = idx + 1
		}

		// Least active: repos with 1-2 commits
		mut rev_idx = len(commits_per_repo) - 1
		mut la_count = 0
		while rev_idx >= 0 && la_count < 5 {
			mut repo = commits_per_repo[rev_idx]
			if to_int(repo["commit_count"]) <= 2 {
				least_active = push(least_active, repo)
				la_count = la_count + 1
			}
			rev_idx = rev_idx - 1
		}
	}

	// Stale repos: repos with no commits in window
	mut all_repos = get_all_repos(db)
	mut active_repo_ids = {}
	mut ai = 0
	while ai < len(commits_per_repo) {
		active_repo_ids[to_string(commits_per_repo[ai]["repo_id"])] = 1
		ai = ai + 1
	}

	mut ri = 0
	while ri < len(all_repos) {
		mut repo = all_repos[ri]
		ri = ri + 1
		if has_key(active_repo_ids, to_string(repo["id"])) == 0 {
			stale_repos = push(stale_repos, {
				"id": repo["id"],
				"name": get_default(repo, "display_name", get_default(repo, "name", "")),
				"path": repo["path"],
				"last_commit_date": get_default(repo, "latest_commit_date", "")
			})
		}
	}

	return add_cors(json_response(200, {
		"success": true,
		"days": days,
		"total_commits": len(commits),
		"commits_by_day": commits_by_day,
		"commits_per_repo": commits_per_repo,
		"most_active": most_active,
		"least_active": least_active,
		"stale_repos": stale_repos,
		"recent_commits": slice(commits, 0, 50)
	}))
}

/// api_bulk_scan performs a full scan of all tracked repos.
export func api_bulk_scan(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut db = init_db()
	mut repos = get_all_repos(db)

	// Create scan run record
	db_execute(db, "INSERT INTO scan_runs (repo_count) VALUES (" + to_string(len(repos)) + ")")
	mut run_rows = db_query(db, "SELECT last_insert_rowid() as id")
	mut run_id = to_int(run_rows[0]["id"])

	mut results = {
		"success": true,
		"run_id": run_id,
		"total": len(repos),
		"scanned": 0,
		"errors": 0,
		"repo_results": []
	}

	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		i = i + 1

		mut scan_result = scan_repo(repo["path"])
		store_scan_result(db, repo["id"], scan_result)

		if scan_result["success"] {
			mut commits = collect_recent_commits(repo["path"], 0)
			store_repo_commits(db, repo["id"], commits)
			results["scanned"] = results["scanned"] + 1
		} else {
			results["errors"] = results["errors"] + 1
		}

		results["repo_results"] = push(results["repo_results"], {
			"repo_id": repo["id"],
			"name": repo["name"],
			"success": scan_result["success"],
			"error": scan_result["error"]
		})
	}

	// Update scan run record
	db_execute(db, "UPDATE scan_runs SET completed_at = datetime('now'), success_count = " + to_string(results["scanned"]) + ", error_count = " + to_string(results["errors"]) + " WHERE id = " + to_string(run_id))

	return add_cors(json_response(200, results))
}

/// api_discover searches for Git repos under a parent directory.
export func api_discover(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut body = req["body"]
	mut data = parse_json(body)

	mut parent_path = get(data, "path")
	if parent_path == null || parent_path == "" {
		return add_cors(json_response(400, {"success": false, "error": "Parent path is required"}))
	}

	mut max_depth = get_default(data, "max_depth", 3)
	mut include_hidden = get_default(data, "include_hidden", 0)

	mut db = init_db()
	mut ignored_str = get_setting(db, "ignored_folders", "node_modules,vendor,.cache,dist,build,.git")
	mut ignored_folders = split(ignored_str, ",")

	mut discovered = discover_repos(parent_path, max_depth, include_hidden, ignored_folders)

	// Filter out already-tracked repos
	mut tracked = get_all_repos(db)
	mut tracked_paths = {}
	mut ti = 0
	while ti < len(tracked) {
		tracked_paths[tracked[ti]["path"]] = 1
		ti = ti + 1
	}

	mut new_repos = []
	mut di = 0
	while di < len(discovered) {
		mut d = discovered[di]
		di = di + 1
		if has_key(tracked_paths, d["path"]) == 0 {
			new_repos = push(new_repos, d)
		}
	}

	return add_cors(json_response(200, {
		"success": true,
		"parent_path": parent_path,
		"total_found": len(discovered),
		"new_repos": new_repos,
		"already_tracked": len(discovered) - len(new_repos)
	}))
}

/// discover_repos recursively searches for .git directories.
export func discover_repos(parent_path, max_depth, include_hidden, ignored_folders) {
	mut results = []

	if max_depth <= 0 {
		return results
	}

	if !file_exists(parent_path) || !path_is_dir(parent_path) {
		return results
	}

	mut entries = list_dir(parent_path)
	mut ei = 0
	while ei < len(entries) {
		mut entry = entries[ei]
		ei = ei + 1

		mut full_path = join_path(parent_path, entry)

		// Skip ignored folders
		mut should_skip = 0
		mut ig = 0
		while ig < len(ignored_folders) {
			mut ignored = trim(ignored_folders[ig])
			ig = ig + 1
			if ignored == "" { continue }
			if entry == ignored {
				should_skip = 1
				break
			}
		}

		if should_skip == 1 {
			continue
		}

		// Skip hidden folders unless included
		if include_hidden == 0 && starts_with(entry, ".") == 1 && entry != ".git" {
			continue
		}

		if path_is_dir(full_path) {
			if entry == ".git" {
				// Found a git repo at parent
				mut repo_path = parent_path
				mut name = basename(repo_path)
				results = push(results, {
					"name": name,
					"path": repo_path
				})
			} else {
				// Recurse
				mut sub_results = discover_repos(full_path, max_depth - 1, include_hidden, ignored_folders)
				mut sr = 0
				while sr < len(sub_results) {
					results = push(results, sub_results[sr])
					sr = sr + 1
				}
			}
		}
	}

	return results
}

/// api_bulk_add adds multiple repos at once.
export func api_bulk_add(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut body = req["body"]
	mut data = parse_json(body)
	mut repos_to_add = get(data, "repos")
	if repos_to_add == null {
		return add_cors(json_response(400, {"success": false, "error": "Repos array is required"}))
	}

	mut db = init_db()
	mut results = {
		"success": true,
		"added": 0,
		"skipped": 0,
		"errors": 0,
		"details": []
	}

	mut i = 0
	while i < len(repos_to_add) {
		mut repo_info = repos_to_add[i]
		i = i + 1

		mut path = get(repo_info, "path")
		mut display_name = get_default(repo_info, "display_name", "")
		mut group_name = get_default(repo_info, "group_name", "")
		mut tags = get_default(repo_info, "tags", "")
		mut notes = get_default(repo_info, "notes", "")
		mut pinned = get_default(repo_info, "pinned", 0)

		mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)
		if result["success"] {
			results["added"] = results["added"] + 1
		} else {
			results["skipped"] = results["skipped"] + 1
		}
		results["details"] = push(results["details"], result)
	}

	return add_cors(json_response(200, results))
}

/// api_settings_get returns all settings.
export func api_settings_get(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut rows = db_query(db, "SELECT key, value FROM settings")
	mut settings = {}
	mut i = 0
	while i < len(rows) {
		settings[rows[i]["key"]] = rows[i]["value"]
		i = i + 1
	}

	return add_cors(json_response(200, {"success": true, "settings": settings}))
}

/// api_settings_update updates multiple settings.
export func api_settings_update(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "PUT" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut body = req["body"]
	mut data = parse_json(body)
	mut settings = get(data, "settings")
	if settings == null {
		return add_cors(json_response(400, {"success": false, "error": "Settings object is required"}))
	}

	mut db = init_db()
	mut setting_keys = keys(settings)
	mut i = 0
	while i < len(setting_keys) {
		mut key = setting_keys[i]
		mut value = settings[key]
		set_setting(db, key, to_string(value))
		i = i + 1
	}

	return add_cors(json_response(200, {"success": true}))
}

/// api_export returns the full registry as JSON for export.
export func api_export(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)
	mut settings_rows = db_query(db, "SELECT key, value FROM settings")
	mut settings = {}
	mut i = 0
	while i < len(settings_rows) {
		settings[settings_rows[i]["key"]] = settings_rows[i]["value"]
		i = i + 1
	}

	mut export_data = {
		"app": "reporadar",
		"version": "0.1.0",
		"exported_at": "",
		"settings": settings,
		"repos": repos
	}

	mut resp = add_cors(json_response(200, export_data))
	resp = set_header(resp, "Content-Disposition", "attachment; filename=\"reporadar-export.json\"")
	return resp
}

/// api_import imports repos from a JSON file.
export func api_import(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}))
	}

	mut body = req["body"]
	mut data = parse_json(body)

	// Validate structure
	if get(data, "app") != "reporadar" {
		return add_cors(json_response(400, {"success": false, "error": "Invalid import file: not a RepoRadar export"}))
	}

	mut imported_repos = get(data, "repos")
	if imported_repos == null {
		return add_cors(json_response(400, {"success": false, "error": "Invalid import file: no repos found"}))
	}

	mut db = init_db()
	mut results = {
		"success": true,
		"imported": 0,
		"skipped": 0,
		"errors": 0,
		"details": []
	}

	mut i = 0
	while i < len(imported_repos) {
		mut repo_data = imported_repos[i]
		i = i + 1

		mut path = get(repo_data, "path")
		if path == null || path == "" {
			results["errors"] = results["errors"] + 1
			continue
		}

		// Check if path already tracked
		mut existing = db_query(db, "SELECT id FROM repos WHERE path = '" + replace_str(path, "'", "''") + "'")
		if len(existing) > 0 {
			results["skipped"] = results["skipped"] + 1
			continue
		}

		// Validate path exists
		if !file_exists(path) {
			results["skipped"] = results["skipped"] + 1
			continue
		}

		mut display_name = get_default(repo_data, "display_name", "")
		mut group_name = get_default(repo_data, "group_name", "")
		mut tags = get_default(repo_data, "tags", "")
		mut notes = get_default(repo_data, "notes", "")
		mut pinned = get_default(repo_data, "pinned", 0)

		mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)
		if result["success"] {
			results["imported"] = results["imported"] + 1
		} else {
			results["skipped"] = results["skipped"] + 1
		}
		results["details"] = push(results["details"], result)
	}

	// Import settings if present
	mut imported_settings = get(data, "settings")
	if imported_settings != null {
		mut setting_keys = keys(imported_settings)
		mut si = 0
		while si < len(setting_keys) {
			mut key = setting_keys[si]
			set_setting(db, key, to_string(imported_settings[key]))
			si = si + 1
		}
	}

	return add_cors(json_response(200, results))
}

/// api_export_db backs up the database file.
export func api_export_db(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db_path = get_db_path()
	if !file_exists(db_path) {
		return add_cors(json_response(404, {"success": false, "error": "Database file not found"}))
	}

	mut content = read_file(db_path)
	mut resp = http_response(200, content)
	resp = set_header(resp, "Content-Type", "application/octet-stream")
	resp = set_header(resp, "Content-Disposition", "attachment; filename=\"reporadar-backup.db\"")
	return add_cors(resp)
}

// === Static file serving ===

/// get_mime_type returns the MIME type for a file extension.
export func get_mime_type(filename) {
	if ends_with(filename, ".html") == 1 { return "text/html" }
	if ends_with(filename, ".css") == 1 { return "text/css" }
	if ends_with(filename, ".js") == 1 { return "application/javascript" }
	if ends_with(filename, ".json") == 1 { return "application/json" }
	if ends_with(filename, ".svg") == 1 { return "image/svg+xml" }
	if ends_with(filename, ".png") == 1 { return "image/png" }
	if ends_with(filename, ".ico") == 1 { return "image/x-icon" }
	return "application/octet-stream"
}

/// serve_static serves a static file from the static/ directory.
export func serve_static(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut url_path = req["path"]

	// Determine file path
	mut file_path = ""
	if url_path == "/" || url_path == "" {
		file_path = "static/index.html"
	} else {
		file_path = "static" + url_path
	}

	// Remove leading slash if present
	if starts_with(file_path, "/") == 1 {
		file_path = substring(file_path, 1, len(file_path))
	}

	if !file_exists(file_path) {
		// Fallback to index.html for SPA routing
		if file_exists("static/index.html") {
			mut content = read_file("static/index.html")
			mut resp = http_response(200, content)
			resp = set_header(resp, "Content-Type", "text/html")
			return add_cors(resp)
		}
		return add_cors(json_response(404, {"success": false, "error": "Not found"}))
	}

	mut content = read_file(file_path)
	mut mime = get_mime_type(file_path)
	mut resp = http_response(200, content)
	resp = set_header(resp, "Content-Type", mime)
	// Cache busting for dev
	resp = set_header(resp, "Cache-Control", "no-cache")
	return add_cors(resp)
}

// === API routes mapping ===

/// setup_routes configures all API and static routes on the server.
export func setup_routes(server) {
	// Static file serving - catch-all for non-API paths
	server = server.route("GET", "/", serve_static)
	server = server.route("GET", "/static/*", serve_static)

	// API routes
	server = server.route("GET", "/api/repos", api_list_repos)
	server = server.route("POST", "/api/repos", api_add_repo)
	server = server.route("DELETE", "/api/repos/:id", api_remove_repo)
	server = server.route("PUT", "/api/repos/:id", api_update_repo)
	server = server.route("POST", "/api/repos/:id/scan", api_scan_repo)
	server = server.route("GET", "/api/repos/:id", api_repo_detail)
	server = server.route("GET", "/api/dashboard/summary", api_dashboard_summary)
	server = server.route("GET", "/api/activity", api_activity)
	server = server.route("POST", "/api/scan/bulk", api_bulk_scan)
	server = server.route("POST", "/api/discover", api_discover)
	server = server.route("POST", "/api/repos/bulk-add", api_bulk_add)
	server = server.route("GET", "/api/settings", api_settings_get)
	server = server.route("PUT", "/api/settings", api_settings_update)
	server = server.route("GET", "/api/export", api_export)
	server = server.route("POST", "/api/import", api_import)
	server = server.route("GET", "/api/export/db", api_export_db)

	return server
}

/// start_server initializes the database, sets up routes, and starts the HTTP server.
export func start_server(port) {
	print("")
	print("=== RepoRadar v0.1.0 ===")
	print("")

	mut db = init_db()
	print("Database ready.")

	mut server = http_listen("127.0.0.1", port)
	server = setup_routes(server)

	print("Starting server on http://127.0.0.1:" + to_string(port))
	print("Press Ctrl+C to stop")
	print("")

	server.listen()

	return 0
}
