// server.kujo — RepoRadar HTTP Server + API Routes
// Serves the dashboard UI and provides JSON API endpoints.

from src.db import init_db, get_db_path, get_setting, set_setting, escape_sql
from src.scanner import validate_git_repo, validate_repo_path, get_canonical_path
from src.registry import add_repo, remove_repo, update_repo, get_all_repos, get_repo_by_id, scan_and_store, get_repo_file_changes, get_repo_scan_history, get_repo_commits, get_activity_feed, get_activity_total, get_repo_stale_map, get_commits_by_day, get_commit_count_per_repo
from src.version import app_version
from src.health_report import build_review_report

/// Validate authority independently of Origin; no suffix or username aliases.
export func is_loopback_authority(host) {
	if !is_string(host) { return false }
	mut name = host
	mut port = ""
	if starts_with(host, "[::1]:") { name = "[::1]"; port = substring(host, 6, len(host)) }
	else if contains(host, ":") == 1 && host != "[::1]" {
		mut parts = split(host, ":")
		if len(parts) != 2 { return false }
		name = parts[0]; port = parts[1]
	}
	if name != "127.0.0.1" && name != "localhost" && name != "[::1]" { return false }
	if host != name {
		if port == "" { return false }
		mut i = 0
		while i < len(port) {
			mut ch = char_at(port, i)
			if ch < "0" || ch > "9" { return false }
			i = i + 1
		}
		if parse_int(port) < 1 || parse_int(port) > 65535 { return false }
	}
	return true
}

export func repo_payload_error(data, require_path) {
	if !is_dict(data) { return "Repository must be an object" }
	if require_path {
		if !is_string(get(data, "path")) { return "Path must be a string" }
		if trim(data["path"]) == "" { return "Path is required" }
	}
	mut fields = ["display_name", "group_name", "tags", "notes"]
	mut i = 0
	while i < len(fields) {
		mut value = get(data, fields[i])
		if value != null && !is_string(value) { return fields[i] + " must be a string" }
		i = i + 1
	}
	return ""
}

export func settings_payload_error(settings) {
	if !is_dict(settings) { return "Settings must be an object" }
	mut names = keys(settings)
	mut i = 0
	while i < len(names) {
		mut value = settings[names[i]]
		if is_array(value) || is_dict(value) || value == null { return "Settings values must be scalar" }
		i = i + 1
	}
	return ""
}

/// All route callbacks pass this boundary before invoking a handler.
export func dispatch_request(req, handler) {
	if !is_loopback_authority(request_header(req, "Host", "host")) {
		return add_cors(json_response(403, {"success": false, "error": "Invalid localhost authority"}), req)
	}
	mut method = req["method"]
	mut path = req["path"]
	mut json_body = (method == "POST" && (path == "/api/repos" || path == "/api/discover" || path == "/api/repos/bulk-add" || path == "/api/import")) || method == "PUT"
	if method == "POST" || method == "PUT" || method == "DELETE" {
		mut policy = mutation_request_error(req, 0)
		if json_body { policy = mutation_request_error(req, 1) }
		if policy != null { return mutation_error_response(policy, req) }
	}
	if json_body {
		mut data = null
		try { data = parse_json(req["body"]) } except err {
			return add_cors(json_response(400, {"success": false, "error": "Invalid JSON"}), req)
		}
		if !is_dict(data) { return add_cors(json_response(400, {"success": false, "error": "JSON body must be an object"}), req) }
		mut error = ""
		if path == "/api/import" || path == "/api/repos/bulk-add" {
			mut repos = get(data, "repos")
			if !is_array(repos) { error = "Repos must be an array" }
			else {
				if len(repos) > 1000 { return add_cors(json_response(413, {"success": false, "error": "Repository limit is 1000"}), req) }
				mut i = 0
				while i < len(repos) && error == "" { error = repo_payload_error(repos[i], true); i = i + 1 }
			}
		} else if path == "/api/repos" || starts_with(path, "/api/repos/") {
			error = repo_payload_error(data, method == "POST")
		} else if path == "/api/discover" {
			if !is_string(get(data, "path")) { error = "Path must be a string" }
			else if trim(data["path"]) == "" { error = "Path is required" }
			if is_string(get(data, "path")) && data["path"] == "/" { error = "Choose a directory below the filesystem root" }
			mut hidden = get(data, "include_hidden")
			if hidden != null && !is_int(hidden) { error = "include_hidden must be an integer" }
			mut depth = get(data, "max_depth")
			if depth != null && !is_int(depth) { error = "max_depth must be an integer" }
		}
		if error == "" && (path == "/api/settings" || (path == "/api/import" && has_key(data, "settings") == 1)) {
			mut settings = get(data, "settings")
			error = settings_payload_error(settings)
			if error == "" && len(keys(settings)) > 50 {
				return add_cors(json_response(413, {"success": false, "error": "Settings limit is 50 keys"}), req)
			}
		}
		if error != "" { return add_cors(json_response(400, {"success": false, "error": error}), req) }
		req["data"] = data
	}
	try { return handler(req) } except err {
		// Preserve the server-side diagnostic; clients receive a stable bounded error.
		print("Request failed " + method + " " + path + ": " + to_string(err))
		return add_cors(json_response(500, {"success": false, "error": "Request failed; see server log"}), req)
	}
}

/// is_allowed_origin returns true for same-machine browser origins.
export func is_allowed_origin(origin) {
	if origin == null || origin == "" {
		return true
	}
	if origin == "http://127.0.0.1" || starts_with(origin, "http://127.0.0.1:") {
		return true
	}
	if origin == "http://localhost" || starts_with(origin, "http://localhost:") {
		return true
	}
	if origin == "http://[::1]" || starts_with(origin, "http://[::1]:") {
		return true
	}
	return false
}

/// request_origin returns the Origin header when the Kujo HTTP layer exposes it.
export func request_origin(req) {
	mut headers = get_default(req, "headers", {})
	mut origin = get_default(headers, "Origin", "")
	if origin == "" {
		origin = get_default(headers, "origin", "")
	}
	return origin
}

/// request_header reads a header across the common Kujo key casings.
export func request_header(req, canonical_name, lowercase_name) {
	mut headers = get_default(req, "headers", {})
	mut value = get_default(headers, canonical_name, "")
	if value == "" {
		value = get_default(headers, lowercase_name, "")
	}
	return value
}

/// is_same_origin_request allows browser mutations only from the exact served origin.
/// Origin-less clients remain supported for local CLI and agent integrations.
export func is_same_origin_request(req) {
	mut origin = request_origin(req)
	if origin == null || origin == "" {
		return true
	}
	mut host = request_header(req, "Host", "host")
	if host == "" {
		return false
	}
	return origin == "http://" + host
}

/// is_json_request accepts the standard JSON media type and optional parameters.
export func is_json_request(req) {
	mut content_type = request_header(req, "Content-Type", "content-type")
	return content_type == "application/json" || starts_with(content_type, "application/json;")
}

/// mutation_request_error centralizes browser and resource-boundary validation.
export func mutation_request_error(req, require_json) {
	if !is_same_origin_request(req) {
		return {"status": 403, "message": "Cross-origin request rejected"}
	}
	mut body = get_default(req, "body", "")
	if len(body) > 1048576 {
		return {"status": 413, "message": "Request body exceeds the 1 MiB limit"}
	}
	if require_json == 1 && !is_json_request(req) {
		return {"status": 415, "message": "Content-Type must be application/json"}
	}
	return null
}

/// mutation_error_response converts a validation error into a protected JSON response.
export func mutation_error_response(error, req) {
	return add_cors(json_response(error["status"], {"success": false, "error": error["message"]}), req)
}

/// cors_headers returns CORS headers limited to localhost browser origins.
export func cors_headers(req) {
	mut origin = request_origin(req)
	mut allowed_origin = "http://127.0.0.1"
	if is_allowed_origin(origin) && origin != "" {
		allowed_origin = origin
	}
	return {
		"Access-Control-Allow-Origin": allowed_origin,
		"Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
		"Access-Control-Allow-Headers": "Content-Type",
		"Vary": "Origin"
	}
}

/// security_headers returns defense-in-depth browser security headers.
export func security_headers() {
	return {
		"X-Content-Type-Options": "nosniff",
		"Referrer-Policy": "no-referrer",
		"X-Frame-Options": "DENY",
		"Permissions-Policy": "camera=(), geolocation=(), microphone=()",
		"Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	}
}

/// handle_options handles CORS preflight requests.
export func handle_options(req) {
	mut resp = http_response(204, "")
	mut headers = cors_headers(req)
	mut hkeys = keys(headers)
	mut i = 0
	while i < len(hkeys) {
		mut k = hkeys[i]
		resp = set_header(resp, k, headers[k])
		i = i + 1
	}
	return add_security_headers(resp)
}

/// add_security_headers adds browser security headers to a response.
export func add_security_headers(resp) {
	mut headers = security_headers()
	mut hkeys = keys(headers)
	mut i = 0
	while i < len(hkeys) {
		mut k = hkeys[i]
		resp = set_header(resp, k, headers[k])
		i = i + 1
	}
	return resp
}

/// add_cors adds CORS headers to a response.
export func add_cors(resp, req) {
	mut headers = cors_headers(req)
	mut hkeys = keys(headers)
	mut i = 0
	while i < len(hkeys) {
		mut k = hkeys[i]
		resp = set_header(resp, k, headers[k])
		i = i + 1
	}
	return add_security_headers(resp)
}

/// api_list_repos returns all tracked repos with latest status.
export func api_list_repos(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)

	mut result = {
		"success": true,
		"repos": repos,
		"total": len(repos)
	}

	return add_cors(json_response(200, result), req)
}

/// api_add_repo handles POST to add a new repo.
export func api_add_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut body = req["body"]
	mut data = req["data"]

	mut path = get(data, "path")
	if path == null || path == "" {
		return add_cors(json_response(400, {"success": false, "error": "Path is required"}), req)
	}

	mut display_name = get_default(data, "display_name", "")
	mut group_name = get_default(data, "group_name", "")
	mut tags = get_default(data, "tags", "")
	mut notes = get_default(data, "notes", "")
	mut pinned = get_default(data, "pinned", 0)

	mut db = init_db()
	mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)

	return add_cors(json_response(200, result), req)
}

/// api_remove_repo handles DELETE to remove a repo.
export func api_remove_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "DELETE" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 0)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}), req)
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()
	mut result = remove_repo(db, repo_id)

	return add_cors(json_response(200, result), req)
}

/// api_update_repo handles PUT to update repo metadata.
export func api_update_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "PUT" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}), req)
	}

	mut repo_id = parse_int(repo_id_str)
	mut body = req["body"]
	mut data = req["data"]

	mut display_name = get(data, "display_name")
	mut group_name = get(data, "group_name")
	mut tags = get(data, "tags")
	mut notes = get(data, "notes")
	mut pinned = get(data, "pinned")
	mut archived = get(data, "archived")

	mut db = init_db()
	mut result = update_repo(db, repo_id, display_name, group_name, tags, notes, pinned, archived)

	return add_cors(json_response(200, result), req)
}

/// api_scan_repo handles POST to scan a single repo.
export func api_scan_repo(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 0)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}), req)
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()

	// Get the repo path
	mut repo = get_repo_by_id(db, repo_id)
	if repo == null {
		return add_cors(json_response(404, {"success": false, "error": "Repo not found"}), req)
	}

	mut repo_path = repo["path"]

	// Run the scan
	mut enable_dependabot_alerts = get_setting(db, "enable_dependabot_alerts", "false") == "true"
	mut scan_result = scan_and_store(db, repo_id, repo_path, enable_dependabot_alerts)
	mut snapshot_id = scan_result["snapshot_id"]

	// Return updated repo data
	mut updated_repo = get_repo_by_id(db, repo_id)
	mut file_changes = get_repo_file_changes(db, repo_id)

	return add_cors(json_response(200, {
		"success": scan_result["success"],
		"repo": updated_repo,
		"scan_result": scan_result,
		"file_changes": file_changes,
		"snapshot_id": snapshot_id
	}), req)
}

/// api_repo_detail returns detailed info for a single repo.
export func api_repo_detail(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut params = req["params"]
	mut repo_id_str = get(params, "id")
	if repo_id_str == null {
		return add_cors(json_response(400, {"success": false, "error": "Repo ID is required"}), req)
	}

	mut repo_id = parse_int(repo_id_str)
	mut db = init_db()

	mut repo = get_repo_by_id(db, repo_id)
	if repo == null {
		return add_cors(json_response(404, {"success": false, "error": "Repo not found"}), req)
	}

	mut file_changes = get_repo_file_changes(db, repo_id)
	mut recent_commits = get_repo_commits(db, repo_id, 20)
	mut scan_history = get_repo_scan_history(db, repo_id, 10)

	return add_cors(json_response(200, {
		"success": true,
		"repo": repo,
		"file_changes": file_changes,
		"recent_commits": recent_commits,
		"scan_history": scan_history
	}), req)
}

/// api_dashboard_summary returns summary counts for the dashboard header.
export func api_dashboard_summary(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)

	mut stale_days = parse_int(get_setting(db, "stale_threshold_days", "14"))
	mut report = build_review_report(repos, get_repo_stale_map(db, stale_days), "all", "")
	mut summary = report["summary"]
	summary["dependabot_alerts"] = summary["security_alerts"]
	summary["attention_repos"] = summary["attention"]
	summary["most_recently_active"] = ""
	summary["last_full_scan"] = ""
	mut most_recent_date = ""
	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		if repo["latest_commit_date"] != null && repo["latest_commit_date"] > most_recent_date {
			most_recent_date = repo["latest_commit_date"]
			summary["most_recently_active"] = repo["display_name"]
		}
		i = i + 1
	}

	// Get last full scan time
	mut scan_rows = db_query(db, "SELECT MAX(completed_at) as last_scan FROM scan_runs")
	if len(scan_rows) > 0 && scan_rows[0]["last_scan"] != null {
		summary["last_full_scan"] = scan_rows[0]["last_scan"]
	}

	return add_cors(json_response(200, {"success": true, "summary": summary}), req)
}

/// api_activity returns commit activity data.
export func api_activity(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut query_params = req["query"]
	mut db = init_db()
	mut days_str = get_default(query_params, "days", get_setting(db, "default_activity_window", "7"))
	mut days = parse_int(days_str)
	if days < 1 {
		days = 7
	}
	if days > 365 {
		days = 365
	}

	mut commits = get_activity_feed(db, days)
	mut total_commits = get_activity_total(db, days)
	mut commits_by_day = get_commits_by_day(db, days)
	mut commits_per_repo = get_commit_count_per_repo(db, days)

	// Determine most active and least active repos
	mut most_active = []
	mut least_active = []
	mut stale_repos = []

	if len(commits_per_repo) > 0 {
		// Most active: top 5
		mut ma_count = len(commits_per_repo)
		if ma_count > 5 { ma_count = 5 }
		mut idx = 0
		while idx < ma_count {
			most_active = push(most_active, commits_per_repo[idx])
			idx = idx + 1
		}

		// Least active: repos with 1-2 commits
		mut rev_idx = len(commits_per_repo) - 1
		mut la_count = 0
		while rev_idx >= 0 && la_count < 5 {
			mut repo = commits_per_repo[rev_idx]
			if to_int(repo["commit_count"]) <= 2 {
				least_active = push(least_active, repo)
				la_count = la_count + 1
			}
			rev_idx = rev_idx - 1
		}
	}

	// Stale repos: repos with no commits in window
	mut all_repos = get_all_repos(db)
	mut active_repo_ids = {}
	mut ai = 0
	while ai < len(commits_per_repo) {
		active_repo_ids[to_string(commits_per_repo[ai]["repo_id"])] = 1
		ai = ai + 1
	}

	mut ri = 0
	while ri < len(all_repos) {
		mut repo = all_repos[ri]
		ri = ri + 1
		if has_key(active_repo_ids, to_string(repo["id"])) == 0 {
			stale_repos = push(stale_repos, {
				"id": repo["id"],
				"name": get_default(repo, "display_name", get_default(repo, "name", "")),
				"path": repo["path"],
				"last_commit_date": get_default(repo, "latest_commit_date", "")
			})
		}
	}

	return add_cors(json_response(200, {
		"success": true,
		"days": days,
		"total_commits": total_commits,
		"history_complete": len(db_query(db,"SELECT id FROM repos WHERE archived=0 AND history_complete=0")) == 0,
		"incomplete_repos": db_query(db,"SELECT id, display_name, history_error, history_scanned_at FROM repos WHERE archived=0 AND history_complete=0 ORDER BY id"),
		"commits_by_day": commits_by_day,
		"commits_per_repo": commits_per_repo,
		"most_active": most_active,
		"least_active": least_active,
		"stale_repos": stale_repos,
		"recent_commits": slice(commits, 0, 50)
	}), req)
}

/// api_bulk_scan performs a full scan of all tracked repos.
export func api_bulk_scan(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 0)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut db = init_db()
	mut repos = get_all_repos(db)

	// Create scan run record
	db_execute(db, "INSERT INTO scan_runs (repo_count) VALUES (" + to_string(len(repos)) + ")")
	mut run_rows = db_query(db, "SELECT last_insert_rowid() as id")
	mut run_id = to_int(run_rows[0]["id"])

	mut results = {
		"success": true,
		"run_id": run_id,
		"total": len(repos),
		"scanned": 0,
		"errors": 0,
		"clean": 0,
		"dirty": 0,
		"repo_results": []
	}

	mut i = 0
	while i < len(repos) {
		mut repo = repos[i]
		i = i + 1

		mut enable_dependabot_alerts = get_setting(db, "enable_dependabot_alerts", "false") == "true"
		mut scan_result = scan_and_store(db, repo["id"], repo["path"], enable_dependabot_alerts)

		if scan_result["success"] {
			results["scanned"] = results["scanned"] + 1
			if scan_result["is_clean"] == 1 {
				results["clean"] = results["clean"] + 1
			} else {
				results["dirty"] = results["dirty"] + 1
			}
		} else {
			results["errors"] = results["errors"] + 1
		}

		results["repo_results"] = push(results["repo_results"], {
			"repo_id": repo["id"],
			"name": repo["name"],
			"success": scan_result["success"],
			"error": scan_result["error"]
		})
	}

	// Update scan run record
	db_execute(db, "UPDATE scan_runs SET completed_at = datetime('now'), success_count = " + to_string(results["scanned"]) + ", error_count = " + to_string(results["errors"]) + ", clean_count = " + to_string(results["clean"]) + ", dirty_count = " + to_string(results["dirty"]) + " WHERE id = " + to_string(run_id))

	return add_cors(json_response(200, results), req)
}

/// Exclusions are independent of the registry: hiding never removes tracked repos or files.
export func api_discovery_exclusions(req) {
	mut db = init_db()
	if req["method"] == "PUT" {
		mut data = req["data"]
		mut paths = get(data, "paths")
		mut action = get(data, "action")
		if !is_array(paths) || (action != "exclude" && action != "restore") {
			return add_cors(json_response(400, {"success":false,"error":"Provide paths and action exclude or restore"}), req)
		}
		if len(paths) > 1000 { return add_cors(json_response(413, {"success":false,"error":"Limit is 1000 paths"}), req) }
		mut normalized = []
		mut i = 0
		while i < len(paths) {
			mut path = paths[i]
			i = i + 1
			if !is_string(path) { return add_cors(json_response(400, {"success":false,"error":"Paths must be strings"}), req) }
			if !starts_with(path, "/") || len(path) > 4096 { return add_cors(json_response(400, {"success":false,"error":"Provide an absolute repository path"}), req) }
			// Restore uses the saved key even when the directory no longer exists.
			if file_exists(path) { path = path_absolute(path) }
			normalized = push(normalized, path)
		}
		db_begin_immediate(db)
		try {
			i = 0
			while i < len(normalized) {
				mut safe = escape_sql(normalized[i])
				i = i + 1
				if action == "exclude" { db_execute(db, "INSERT OR IGNORE INTO discovery_exclusions(path) VALUES ('" + safe + "')") }
				else { db_execute(db, "DELETE FROM discovery_exclusions WHERE path = '" + safe + "'") }
			}
			db_commit(db)
		} except err { db_rollback(db); throw(err) }
	}
	return add_cors(json_response(200, {"success":true,"excluded":db_query(db,"SELECT path, excluded_at FROM discovery_exclusions ORDER BY path")}), req)
}

/// api_discover searches for Git repos under a parent directory.
export func api_discover(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut body = req["body"]
	mut data = req["data"]

	mut parent_path = get(data, "path")
	if parent_path == null || parent_path == "" {
		return add_cors(json_response(400, {"success": false, "error": "Parent path is required"}), req)
	}

	mut max_depth = parse_int(to_string(get_default(data, "max_depth", 3)))
	mut include_hidden = parse_int(to_string(get_default(data, "include_hidden", 0)))
	if max_depth < 1 {
		max_depth = 3
	}
	if max_depth > 10 {
		max_depth = 10
	}
	if include_hidden != 1 {
		include_hidden = 0
	}

	mut db = init_db()
	mut ignored_str = get_setting(db, "ignored_folders", "node_modules,vendor,.cache,dist,build,.git")
	mut ignored_folders = split(ignored_str, ",")

	mut discovery = discover_report(parent_path, max_depth, include_hidden, ignored_folders, {"entries_remaining":25000,"results_remaining":1000})
	mut discovered = discovery["repos"]

	// Archived repositories are still tracked and must not reappear as new.
	mut tracked = db_query(db, "SELECT path FROM repos")
	mut tracked_paths = {}
	mut ti = 0
	while ti < len(tracked) {
		tracked_paths[tracked[ti]["path"]] = 1
		ti = ti + 1
	}

	mut exclusions = db_query(db, "SELECT path FROM discovery_exclusions")
	mut excluded_paths = {}
	mut ei = 0
	while ei < len(exclusions) { excluded_paths[exclusions[ei]["path"]] = 1; ei = ei + 1 }
	mut excluded_count = 0
	mut tracked_count = 0
	mut new_repos = []
	mut di = 0
	while di < len(discovered) {
		mut d = discovered[di]
		di = di + 1
		if has_key(tracked_paths, d["path"]) == 1 { tracked_count = tracked_count + 1 }
		else if has_key(excluded_paths, d["path"]) == 1 { excluded_count = excluded_count + 1 }
		else { new_repos = push(new_repos, d) }
	}

	return add_cors(json_response(200, {
		"success": true,
		"parent_path": parent_path,
		"truncated": discovery["truncated"],
		"entries_examined": discovery["entries_examined"],
		"total_found": len(discovered),
		"new_repos": new_repos,
		"already_tracked": tracked_count,
		"excluded_count": excluded_count
	}), req)
}

/// Compatibility wrappers retain array results; report callers also receive limits.
export func discover_repos(parent_path, max_depth, include_hidden, ignored_folders) {
	return discover_report(parent_path, max_depth, include_hidden, ignored_folders, {"entries_remaining":25000,"results_remaining":1000})["repos"]
}
export func discover_repos_with_budget(parent_path, max_depth, include_hidden, ignored_folders, budget) {
	return discover_report(parent_path, max_depth, include_hidden, ignored_folders, budget)["repos"]
}
export func discover_report(parent_path, max_depth, include_hidden, ignored_folders, budget) {
	mut results = []
	mut remaining = budget["entries_remaining"]
	mut limit = budget["results_remaining"]
	mut truncated = false
	if !file_exists(parent_path) || !path_is_dir(parent_path) { return {"repos":[],"truncated":false,"entries_examined":0,"entry_limit":remaining,"result_limit":limit} }
	if path_absolute(parent_path) == "/" { throw("Choose a directory below the filesystem root") }
	mut queue = [{"path":path_absolute(parent_path),"depth":max_depth,"after":""}]
	mut index = 0
	while index < len(queue) {
		if remaining <= 1 || len(results) >= limit { truncated = true; break }
		mut item = queue[index]
		index = index + 1
		mut path = item["path"]
		if item["depth"] <= 0 || !path_is_dir(path) { continue }
		mut page = null
		try {
			page = list_dir_beneath(dirname(path), basename(path), item["after"], "", 1000, remaining - 1)
		} except err {
			if contains(to_string(err), "[scan_limit]") { remaining = 0; truncated = true; break }
			throw(err)
		}
		remaining = remaining - page["scanned"]
		mut entries = page["names"]
		if page["truncated"] { queue = push(queue, {"path":path,"depth":item["depth"],"after":page["next_cursor"]}) }
		mut i = 0
		while i < len(entries) {
			if len(results) >= limit { truncated = true; break }
			mut entry = entries[i]
			i = i + 1
			mut full_path = join_path(path, entry)
			if path_is_symlink(full_path) { continue }
			if entry == ".git" && (path_is_dir(full_path) || file_exists(full_path)) {
				results = push(results, {"name":basename(path),"path":path})
				continue
			}
			mut skip = false
			mut j = 0
			while j < len(ignored_folders) {
				if entry == trim(ignored_folders[j]) { skip = true }
				j = j + 1
			}
			if skip || (include_hidden == 0 && starts_with(entry, ".")) { continue }
			if item["depth"] > 1 && path_is_dir(full_path) {
				queue = push(queue, {"path":full_path,"depth":item["depth"]-1,"after":""})
			}
		}
	}
	return {"repos":results,"truncated":truncated,"entries_examined":budget["entries_remaining"]-remaining,"entry_limit":budget["entries_remaining"],"result_limit":limit}
}

/// api_bulk_add adds multiple repos at once.
export func api_bulk_add(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut body = req["body"]
	mut data = req["data"]
	mut repos_to_add = get(data, "repos")
	if repos_to_add == null {
		return add_cors(json_response(400, {"success": false, "error": "Repos array is required"}), req)
	}
	if len(repos_to_add) > 1000 {
		return add_cors(json_response(413, {"success": false, "error": "Bulk add is limited to 1000 repositories"}), req)
	}

	mut db = init_db()
	mut results = {
		"success": true,
		"added": 0,
		"skipped": 0,
		"errors": 0,
		"details": []
	}

	mut i = 0
	while i < len(repos_to_add) {
		mut repo_info = repos_to_add[i]
		i = i + 1

		mut path = get(repo_info, "path")
		mut display_name = get_default(repo_info, "display_name", "")
		mut group_name = get_default(repo_info, "group_name", "")
		mut tags = get_default(repo_info, "tags", "")
		mut notes = get_default(repo_info, "notes", "")
		mut pinned = get_default(repo_info, "pinned", 0)

		mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)
		if result["success"] {
			results["added"] = results["added"] + 1
		} else {
			results["skipped"] = results["skipped"] + 1
		}
		results["details"] = push(results["details"], result)
	}

	return add_cors(json_response(200, results), req)
}

/// api_settings_get returns all settings.
export func api_settings_get(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut rows = db_query(db, "SELECT key, value FROM settings")
	mut settings = {}
	mut i = 0
	while i < len(rows) {
		settings[rows[i]["key"]] = rows[i]["value"]
		i = i + 1
	}

	return add_cors(json_response(200, {"success": true, "settings": settings}), req)
}

/// api_settings_update updates multiple settings.
export func api_settings_update(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "PUT" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut body = req["body"]
	mut data = req["data"]
	mut settings = get(data, "settings")
	if settings == null {
		return add_cors(json_response(400, {"success": false, "error": "Settings object is required"}), req)
	}

	mut db = init_db()
	mut setting_keys = keys(settings)
	if len(setting_keys) > 50 {
		return add_cors(json_response(413, {"success": false, "error": "Settings update is limited to 50 keys"}), req)
	}
	mut i = 0
	while i < len(setting_keys) {
		mut key = setting_keys[i]
		mut value = settings[key]
		set_setting(db, key, to_string(value))
		i = i + 1
	}

	return add_cors(json_response(200, {"success": true}), req)
}

/// api_export returns the full registry as JSON for export.
export func api_export(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db = init_db()
	mut repos = get_all_repos(db)
	mut settings_rows = db_query(db, "SELECT key, value FROM settings")
	mut settings = {}
	mut i = 0
	while i < len(settings_rows) {
		settings[settings_rows[i]["key"]] = settings_rows[i]["value"]
		i = i + 1
	}

	mut export_data = {
		"app": "reporadar",
		"version": app_version(),
		"exported_at": "",
		"settings": settings,
		"repos": repos
	}

	mut exported_rows = db_query(db, "SELECT datetime('now') as exported_at")
	if len(exported_rows) > 0 {
		export_data["exported_at"] = exported_rows[0]["exported_at"]
	}

	mut resp = add_cors(json_response(200, export_data), req)
	resp = set_header(resp, "Content-Disposition", "attachment; filename=\"reporadar-export.json\"")
	return resp
}

/// api_import imports repos from a JSON file.
export func api_import(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	if req["method"] != "POST" {
		return add_cors(json_response(405, {"success": false, "error": "Method not allowed"}), req)
	}
	mut request_error = mutation_request_error(req, 1)
	if request_error != null { return mutation_error_response(request_error, req) }

	mut body = req["body"]
	mut data = req["data"]

	// Validate structure
	if get(data, "app") != "reporadar" {
		return add_cors(json_response(400, {"success": false, "error": "Invalid import file: not a RepoRadar export"}), req)
	}

	mut imported_repos = get(data, "repos")
	if imported_repos == null {
		return add_cors(json_response(400, {"success": false, "error": "Invalid import file: no repos found"}), req)
	}
	if len(imported_repos) > 1000 {
		return add_cors(json_response(413, {"success": false, "error": "Import is limited to 1000 repositories"}), req)
	}

	mut db = init_db()
	mut results = {
		"success": true,
		"imported": 0,
		"skipped": 0,
		"errors": 0,
		"details": []
	}

	db_begin_immediate(db)
	try {
	mut i = 0
	while i < len(imported_repos) {
		mut repo_data = imported_repos[i]
		i = i + 1

		mut path = get(repo_data, "path")
		if path == null || path == "" {
			results["errors"] = results["errors"] + 1
			continue
		}

		// Check if path already tracked
		mut existing = db_query(db, "SELECT id FROM repos WHERE path = '" + escape_sql(path) + "'")
		if len(existing) > 0 {
			results["skipped"] = results["skipped"] + 1
			continue
		}

		// Validate path exists
		if !file_exists(path) {
			results["skipped"] = results["skipped"] + 1
			continue
		}

		mut display_name = get_default(repo_data, "display_name", "")
		mut group_name = get_default(repo_data, "group_name", "")
		mut tags = get_default(repo_data, "tags", "")
		mut notes = get_default(repo_data, "notes", "")
		mut pinned = get_default(repo_data, "pinned", 0)

		mut result = add_repo(db, path, display_name, group_name, tags, notes, pinned)
		if result["success"] {
			results["imported"] = results["imported"] + 1
		} else {
			results["skipped"] = results["skipped"] + 1
		}
		results["details"] = push(results["details"], result)
	}

	// Import settings if present
	mut imported_settings = get(data, "settings")
	if imported_settings != null {
		mut setting_keys = keys(imported_settings)
		mut si = 0
		while si < len(setting_keys) {
			mut key = setting_keys[si]
			set_setting(db, key, to_string(imported_settings[key]))
			si = si + 1
		}
	}

		db_commit(db)
	} except err {
		db_rollback(db)
		throw(err)
	}

	return add_cors(json_response(200, results), req)
}

/// api_export_db backs up the database file.
export func api_export_db(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut db_path = get_db_path()
	if !file_exists(db_path) {
		return add_cors(json_response(404, {"success": false, "error": "Database file not found"}), req)
	}

	mut directory = create_temp_dir(dirname(db_path), ".reporadar-backup-")
	mut backup_db = null
	mut backup_path = join_path(directory, "snapshot.db")
	try {
		backup_db = init_db()
		db_execute(backup_db, "VACUUM INTO '" + escape_sql(backup_path) + "'")
		db_close(backup_db)
		backup_db = null
		mut content = read_binary_file(backup_path)
		delete_file(backup_path)
		os_rmdir(directory)
		mut resp = http_response(200, content)
		resp = set_header(resp, "Content-Type", "application/octet-stream")
		resp = set_header(resp, "Content-Disposition", "attachment; filename=\"reporadar-backup.db\"")
		return add_cors(resp, req)
	} except err {
		if backup_db != null { db_close(backup_db) }
		if file_exists(backup_path) { delete_file(backup_path) }
		os_rmdir(directory)
		throw(err)
	}
}

// === Static file serving ===

/// get_mime_type returns the MIME type for a file extension.
export func get_mime_type(filename) {
	if ends_with(filename, ".html") { return "text/html" }
	if ends_with(filename, ".css") { return "text/css" }
	if ends_with(filename, ".js") { return "application/javascript" }
	if ends_with(filename, ".json") { return "application/json" }
	if ends_with(filename, ".svg") { return "image/svg+xml" }
	if ends_with(filename, ".png") { return "image/png" }
	if ends_with(filename, ".ico") { return "image/x-icon" }
	return "application/octet-stream"
}

/// has_static_path_traversal rejects paths that could escape static/.
export func has_static_path_traversal(url_path) {
	if contains(url_path, "..") == 1 {
		return true
	}
	if contains(url_path, "\\") == 1 {
		return true
	}
	if contains(url_path, "%2e") == 1 || contains(url_path, "%2E") == 1 || contains(url_path, "%5c") == 1 || contains(url_path, "%5C") == 1 {
		return true
	}
	return false
}

/// serve_static serves a static file from the static/ directory.
export func serve_static(req) {
	if req["method"] == "OPTIONS" {
		return handle_options(req)
	}

	mut url_path = req["path"]
	if has_static_path_traversal(url_path) {
		return add_cors(json_response(400, {"success": false, "error": "Invalid static path"}), req)
	}

	// Determine file path
	mut file_path = ""
	if url_path == "/" || url_path == "" {
		file_path = "static/index.html"
	} else {
		file_path = "static" + url_path
	}

	// Remove leading slash if present
	if starts_with(file_path, "/") {
		file_path = substring(file_path, 1, len(file_path))
	}

	if !file_exists(file_path) {
		// Fallback to index.html for SPA routing
		if file_exists("static/index.html") {
			mut content = read_file("static/index.html")
			mut resp = http_response(200, content)
			resp = set_header(resp, "Content-Type", "text/html")
			return add_cors(resp, req)
		}
		return add_cors(json_response(404, {"success": false, "error": "Not found"}), req)
	}

	mut content = read_file(file_path)
	if file_path == "static/style.css" && file_exists("static/fonts/DepartureMono-Regular.woff2") {
		mut font_base64 = encode_base64(read_binary_file("static/fonts/DepartureMono-Regular.woff2"))
		content = replace(content, "__DEPARTURE_MONO_WOFF2__", font_base64)
	}
	mut mime = get_mime_type(file_path)
	mut resp = http_response(200, content)
	resp = set_header(resp, "Content-Type", mime)
	// Cache busting for dev
	resp = set_header(resp, "Cache-Control", "no-cache")
	return add_cors(resp, req)
}

// === API routes mapping ===

/// setup_routes configures all API and static routes on the server.
export func setup_routes(server) {
	// Capture this module scope for callbacks invoked by Kujo HTTP worker threads.
	// Static file serving — register each file the dashboard needs
	server = server.route("GET", "/", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/index.html", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/style.css", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/app.js", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/detail.html", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/detail.js", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/activity.html", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/activity.js", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/discovery.html", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/discovery.js", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/settings.html", func(req) { return dispatch_request(req, serve_static) })
	server = server.route("GET", "/settings.js", func(req) { return dispatch_request(req, serve_static) })

	server = server.route("GET", "/api/discovery/exclusions", func(req) { return dispatch_request(req, api_discovery_exclusions) })
	server = server.route("PUT", "/api/discovery/exclusions", func(req) { return dispatch_request(req, api_discovery_exclusions) })

	// API routes
	server = server.route("GET", "/api/repos", func(req) { return dispatch_request(req, api_list_repos) })
	server = server.route("POST", "/api/repos", func(req) { return dispatch_request(req, api_add_repo) })
	server = server.route("DELETE", "/api/repos/:id", func(req) { return dispatch_request(req, api_remove_repo) })
	server = server.route("PUT", "/api/repos/:id", func(req) { return dispatch_request(req, api_update_repo) })
	server = server.route("POST", "/api/repos/:id/scan", func(req) { return dispatch_request(req, api_scan_repo) })
	server = server.route("GET", "/api/repos/:id", func(req) { return dispatch_request(req, api_repo_detail) })
	server = server.route("GET", "/api/dashboard/summary", func(req) { return dispatch_request(req, api_dashboard_summary) })
	server = server.route("GET", "/api/activity", func(req) { return dispatch_request(req, api_activity) })
	server = server.route("POST", "/api/scan/bulk", func(req) { return dispatch_request(req, api_bulk_scan) })
	server = server.route("POST", "/api/discover", func(req) { return dispatch_request(req, api_discover) })
	server = server.route("POST", "/api/repos/bulk-add", func(req) { return dispatch_request(req, api_bulk_add) })
	server = server.route("GET", "/api/settings", func(req) { return dispatch_request(req, api_settings_get) })
	server = server.route("PUT", "/api/settings", func(req) { return dispatch_request(req, api_settings_update) })
	server = server.route("GET", "/api/export", func(req) { return dispatch_request(req, api_export) })
	server = server.route("POST", "/api/import", func(req) { return dispatch_request(req, api_import) })
	server = server.route("GET", "/api/export/db", func(req) { return dispatch_request(req, api_export_db) })

	return server
}

/// start_server initializes the database, sets up routes, and starts the HTTP server.
export func start_server(port) {
	print("")
	print("=== RepoRadar v" + app_version() + " ===")
	print("")

	mut db = init_db()
	print("Database ready.")

	mut server = http_listen("127.0.0.1", port)
	server = setup_routes(server)

	print("Starting server on http://127.0.0.1:" + to_string(port))
	print("Press Ctrl+C to stop")
	print("")

	server.listen()

	return 0
}
